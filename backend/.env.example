# Copy to backend/.env for local development (never committed).
# Tests never read this file.

# Required
DATABASE_URL=postgresql://urlshortener:change-me@localhost:5432/urlshortener
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# Optional
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Tests read these from the shell environment, not from this file:
# TEST_DATABASE_URL=postgresql://urlshortener:change-me@localhost:5432/urlshortener_test
# TEST_REDIS_URL=redis://localhost:6379/15
