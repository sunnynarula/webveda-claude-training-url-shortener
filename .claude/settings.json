{
  "permissions": {
    "defaultMode": "acceptEdits",
    "ask": [
      "Bash(git push *)",
      "Bash(git push)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-frozen.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "testing-agent|verification-agent|security-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-verdict.sh"
          }
        ]
      }
    ]
  }
}
